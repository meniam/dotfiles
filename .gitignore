# Anchored to the repository root: an unanchored pattern also matches a
# directory of the same name inside a module payload, which silently kept
# modules/zsh/config/.local/share/dc/docs out of the repository.
/gist
/docs
.vscode/*
.backups
.DS_Store
.ruff_cache
theme-builder.html
modules/git/config/.config/git/work.conf
modules/git/config/.config/git/personal.conf
modules/nvim/config/.config/nvim/lazy-lock.json
