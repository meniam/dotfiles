#!/usr/bin/env bash
# ss - short front end for connecting to a host from ~/.ssh/config.
#
# Called with no arguments it opens an fzf picker of the configured hosts, with
# the host's config block shown beside the list, and connects to the chosen one.
# A first argument that names a host connects straight away; anything else
# prefills the picker's search.
#
# On Linux this shadows iproute2's `ss` while ~/.local/bin comes first on PATH;
# the socket statistics tool is still reachable as `/usr/sbin/ss`.
set -euo pipefail

program="${0##*/}"

# The host preview re-enters this script, so it needs a path fzf's shell can
# run. $0 is already a path unless the script was found on PATH.
self="$0"
case "$self" in
  */*) ;;
  *) self="$(command -v -- "$self")" ;;
esac

die() {
  printf '%s: %s\n' "$program" "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: ss [host|query] [ssh-argument...]

  ss                 Pick a host in an fzf picker and connect
  ss <query>         Same, with the picker's search prefilled
  ss <host> [args]   Connect to a configured host; extra arguments go to ssh

Hosts come from ~/.ssh/config and the config.local and config.d/*.conf files it
includes, skipping wildcard patterns such as `Host *`. A `Host` line with
several names is listed as `main-name (alias, alias)`, and connecting uses
main-name.
USAGE
}

# --------------------------------------------------------------------------
# Config files
# --------------------------------------------------------------------------

# The files the ssh module's layout spreads host definitions over. An unmatched
# config.d glob expands to itself, so every candidate is tested.
ssh_config_files=()
for ssh_config_candidate in \
  "$HOME/.ssh/config" \
  "$HOME/.ssh/config.local" \
  "$HOME"/.ssh/config.d/*.conf; do
  if [ -f "$ssh_config_candidate" ]; then
    ssh_config_files+=("$ssh_config_candidate")
  fi
done
unset ssh_config_candidate

have_config() {
  [ "${#ssh_config_files[@]}" -gt 0 ]
}

# --------------------------------------------------------------------------
# Hosts
# --------------------------------------------------------------------------

# One line per host, wildcard patterns dropped and extra names collected into a
# parenthesized group after the first one.
hosts() {
  have_config || return 0

  awk '
    tolower($1) == "host" {
      n = 0
      for (i = 2; i <= NF; i++) if ($i !~ /[*?]/) names[++n] = $i
      if (n == 0) next
      line = names[1]
      if (n > 1) {
        extra = names[2]
        for (i = 3; i <= n; i++) extra = extra ", " names[i]
        line = line " (" extra ")"
      }
      print line
    }
  ' "${ssh_config_files[@]}" 2>/dev/null | sort -u
}

# The connectable host name of a picker line, without its "(alias, alias)".
host_name() {
  printf '%s\n' "${1%% (*}"
}

# True when the argument is one of the configured names, alias included. It
# decides whether a first argument is a host to connect to or a search query,
# so it compares as a string rather than as a pattern.
host_exists() {
  have_config || return 1

  awk -v target="$1" '
    tolower($1) == "host" {
      for (i = 2; i <= NF; i++) if ($i == target) { found = 1; exit }
    }
    END { exit found ? 0 : 1 }
  ' "${ssh_config_files[@]}" 2>/dev/null
}

# The config block of one host, run by fzf as `ss --preview-host <line>`. It
# replaces the bat file preview inherited from FZF_DEFAULT_OPTS, which reports
# every host name as a missing file. A block runs from its Host line to the
# next one, minus the trailing blank lines and comments, which introduce the
# following host rather than describing this one.
preview_host() {
  name="$(host_name "$1")"
  have_config || return 0

  body="$(awk -v target="$name" '
    tolower($1) == "host" {
      show = 0
      for (i = 2; i <= NF; i++) if ($i == target) show = 1
    }
    show {
      block[++n] = $0
      if ($0 !~ /^[[:space:]]*($|#)/) last = n
    }
    END { for (i = 1; i <= last; i++) print block[i] }
  ' "${ssh_config_files[@]}" 2>/dev/null)"

  if [ -z "$body" ]; then
    printf 'No configuration for %s.\n' "$name"
    return 0
  fi

  if command -v bat >/dev/null 2>&1; then
    printf '%s\n' "$body" |
      bat --color=always --language=ssh_config --style=plain --paging=never
  else
    printf '%s\n' "$body"
  fi
}

# --------------------------------------------------------------------------
# Picker
# --------------------------------------------------------------------------

# Cancelling the picker leaves the whole command cancelled, so its exit status
# has to be caught before `set -e` turns it into an error message. fzf exits
# 130 when it is aborted and 1 when nothing matched.
#
# Ctrl-Q is bound to abort here because fzf only ships Esc and Ctrl-C.
run_fzf() {
  status=0
  chosen="$(fzf --bind=ctrl-q:abort "$@")" || status=$?
  case "$status" in
    0) printf '%s' "$chosen" ;;
    1 | 130) exit 130 ;;
    *) die "fzf exited with status $status." ;;
  esac
}

pick_host() {
  listing="$(hosts)"
  [ -n "$listing" ] || die "no hosts in ~/.ssh/config."

  # fzf quotes {} itself, so the line reaches the script as one argument.
  printf '%s\n' "$listing" |
    run_fzf --height=60% --reverse --no-multi --prompt='ssh > ' \
      --query="$1" \
      --preview="'$self' --preview-host {}" \
      --preview-window='right,60%'
}

# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------

case "${1:-}" in
  -h | --help | help)
    usage
    exit 0
    ;;
  --preview-host)
    # Internal: the picker's preview calls the script back rather than baking
    # the whole awk program into an fzf option string.
    shift
    [ $# -eq 1 ] || die "--preview-host takes one picker line."
    preview_host "$1"
    exit 0
    ;;
esac

command -v ssh >/dev/null 2>&1 || die "ssh is not on PATH."

# A known host connects without a picker, so `ss <host>` stays a plain ssh call
# and keeps working over a pipe or in a script.
if [ $# -gt 0 ] && host_exists "$1"; then
  exec ssh "$@"
fi

command -v fzf >/dev/null 2>&1 || die "fzf is not on PATH. Pass a configured host instead."
{ [ -t 0 ] && [ -t 2 ]; } || die "no terminal for the picker. Pass a configured host instead."

# The picker runs in a command substitution, so its exit ends that subshell
# rather than the script; the status has to be carried out by hand. 130 is the
# aborted picker, anything else non-zero is a failure that already explained
# itself.
query="${1:-}"
[ $# -eq 0 ] || shift

status=0
selected="$(pick_host "$query")" || status=$?
[ "$status" -eq 0 ] || exit "$status"
[ -n "$selected" ] || exit 130

exec ssh "$(host_name "$selected")" "$@"
