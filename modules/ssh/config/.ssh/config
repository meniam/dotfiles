# OpenSSH client defaults.
#
# ssh keeps the FIRST value it obtains for every keyword, which is the opposite
# of Git's include semantics. The includes therefore come before the Host *
# block below: whatever a per-host entry sets locally wins, and this file only
# fills in the keywords nothing else claimed. Include paths that do not resolve
# are ignored silently, so neither file has to exist.
Include ~/.ssh/config.local
Include ~/.ssh/config.d/*.conf

Host *
    # UseKeychain is an Apple addition. Portable OpenSSH rejects the whole
    # config on an unknown keyword, so it has to be declared optional first.
    IgnoreUnknown UseKeychain
    UseKeychain yes

    # A passphrase entered once is handed to the running agent.
    AddKeysToAgent yes

    # Reuse one authenticated connection for every later session to the same
    # host, so Git over SSH pays a single handshake instead of one per fetch.
    # %C is a fixed-length hash of the connection, which keeps the socket path
    # under the ~104 byte limit that applies to unix domain sockets.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # Notice a dead peer over the encrypted channel rather than through TCP, so
    # a persistent master does not linger after the network changes.
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive no
