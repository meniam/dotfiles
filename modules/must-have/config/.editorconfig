# EditorConfig is awesome: https://EditorConfig.org

# Fallback for files outside a project that ships its own .editorconfig.
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 4

# Trailing whitespace is a hard line break in Markdown
[*.md]
trim_trailing_whitespace = false

# Ecosystems that conventionally indent with two spaces
[*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,yml,yaml,css,scss,html,vue,svelte,toml}]
indent_size = 2

# Tab indentation (no size specified)
[{Makefile,*.mk,*.go}]
indent_style = tab
