# Every option here applies to every curl invocation on this machine, including
# the ones inside installer and CI scripts, so this file stays limited to
# transport behaviour and never touches what curl writes or where it writes it.
#
# Format: one long option per line without the leading dashes, a value after
# `=` when the option takes one.

# Disguise as IE 9 on Windows 7.
#user-agent = "Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)"

# When following a redirect, automatically set the previous URL as referer.
referer = ";auto"

# Wait 60 seconds before timing out.
connect-timeout = 60

# Follow redirects. Most download URLs are one, and a script that already passes
# -L is unaffected. The exception to know about: a script that deliberately reads
# the 3xx response itself now receives the final one instead.
location

# Ask for gzip and decompress it transparently. The bytes curl writes out are
# the same, only the transfer is smaller.
compressed

# Retry a transient failure — a timeout, a connection reset, a 5xx — three times,
# two seconds apart, instead of failing on the first one.
retry = 3
retry-delay = 2

# Assume HTTPS for a URL given without a scheme, so `curl example.com` no longer
# starts in cleartext.
proto-default = https

# Treat `{}` and `[]` in a URL literally. curl otherwise expands them into a
# series of requests, which breaks any URL whose query string contains them.
globoff

# Deliberately absent: `silent` and `fail` change what a caller sees rather than
# how the transfer happens. `silent` hides the progress meter but also the error
# messages every script here relies on, and `fail` suppresses the response body
# on an HTTP error, which turns a readable API error into an empty exit code.
