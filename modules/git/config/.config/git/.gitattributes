# Global attributes, applied through core.attributesFile in core.conf. A
# repository's own .gitattributes overrides anything set here.

# Normalise to LF in the repository and in the working tree, letting Git detect
# which files are text. The sections below only override this default.
* text=auto eol=lf

# Documents. These are container formats, so they are marked binary: Git then
# skips both end-of-line normalisation and any attempt to diff them by line.
#
# `diff=astextplain` used to be here instead. That driver ships with Git for
# Windows and does not exist on macOS or Linux, and no [diff "astextplain"]
# section defines it, so Git silently ignored the attribute. Character classes
# cover the upper- and mixed-case spellings, which a plain `*.pdf` pattern does
# not match.
*.[Dd][Oo][Cc] binary
*.[Dd][Oo][Cc][Xx] binary
*.[Dd][Oo][Tt] binary
*.[Pp][Dd][Ff] binary
*.[Rr][Tt][Ff] binary

# Markup and tabular data
*.md text
*.adoc text
*.textile text
*.mustache text
*.csv text
*.tab text
*.tsv text
*.sql text

# Graphics
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.ico binary
# SVG treated as an asset (binary) by default. If you want to treat it as text,
# comment-out the following line and uncomment the line after.
*.svg binary
#*.svg text
*.eps binary

# Source code
*.php text
*.twig text
*.js text
*.ts text
*.css text
*.scss text

# Configuration and data
*.json text
*.xml text
*.yml text
*.yaml text
*.ini text
*.neon text
*.env text

# Documentation and scripts
*.txt text
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
